# Polaris MIS Backend Environment Variables

# Primary Neon/PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Live Academic LMS Database URL (Supabase/PostgreSQL)
SOURCE_DATABASE_URL=postgresql://user:password@host:port/postgres?sslmode=require

# Security & Session
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENVIRONMENT=production
COOKIE_SECURE=true
ALLOWED_ORIGINS=["https://your-frontend-domain.com","https://polaris-mis.vercel.app"]

# Data Source Metadata
SOURCE_DUMP=LMS_full_backup.dump
SOURCE_SNAPSHOT=2026-10-29

# Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=["gemini-3.1-flash-lite","gemini-2.5-flash-lite"]
AI_QUERY_TIMEOUT_MS=8000
AI_MAX_ROWS=200

# Google OAuth Single Sign-On
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_ALLOWED_DOMAINS=["polariscampus.com","classplus.co"]
GOOGLE_ALLOWED_EMAILS=["mukul@classplus.co","devang@classplus.co","s.avinash@polariscampus.com","saurabh.bodke@polariscampus.com","gurudev.singla@polariscampus.com"]
GOOGLE_DEFAULT_ROLE=admin
