# ==============================================================================
# POLARIS MIS - BACKEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Primary PostgreSQL / Neon Database URL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 2. Live Academic Supabase LMS Database URL (Read-Only Source)
SOURCE_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
SOURCE_DUMP=Production Supabase LMS
SOURCE_SNAPSHOT=Live read-only

# 3. Environment & Security Settings
ENVIRONMENT=production
COOKIE_SECURE=true
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 4. Allowed Frontend Origins
ALLOWED_ORIGINS=["https://polaris-mis.vercel.app","https://mis.polariscampus.com"]

# 5. Gemini AI Assistant Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=["gemini-3.1-flash-lite","gemini-2.5-flash-lite"]
AI_QUERY_TIMEOUT_MS=8000
AI_MAX_ROWS=200

# 6. Google OAuth Single Sign-On (SSO)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_ALLOWED_DOMAINS=["polariscampus.com","classplus.co"]
GOOGLE_ALLOWED_EMAILS=["mukul@classplus.co","devang@classplus.co","s.avinash@polariscampus.com","saurabh.bodke@polariscampus.com","gurudev.singla@polariscampus.com"]
GOOGLE_DEFAULT_ROLE=admin
